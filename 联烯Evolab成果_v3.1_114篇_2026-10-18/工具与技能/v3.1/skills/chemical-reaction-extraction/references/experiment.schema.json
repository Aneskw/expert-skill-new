{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chemical-experiment-v1",
  "title": "Evidence-linked chemical experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "document_id",
    "source_reaction_id",
    "record_kind",
    "status",
    "completeness",
    "evidence_ids",
    "participants",
    "steps",
    "outcomes",
    "notes",
    "review"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "source_reaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_kind": {
      "enum": [
        "reported_experiment",
        "optimization_entry",
        "substrate_scope_entry",
        "general_scheme",
        "mechanism",
        "literature_example",
        "unresolved"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "needs_review",
        "reviewed",
        "rejected"
      ]
    },
    "completeness": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "reviewer",
        "checked_fields",
        "unresolved"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "model",
            "human",
            "assistant_visual"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence_ids",
        "verification"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verification": {
          "enum": [
            "missing",
            "unreviewed",
            "source_checked",
            "inferred"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fact"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fact": {
          "$ref": "#/$defs/fact"
        },
        "category": {
          "enum": [
            "time",
            "temperature",
            "yield",
            "percentage",
            "mass",
            "amount",
            "volume",
            "equivalents",
            "concentration",
            "selectivity",
            "measurement_basis",
            "atmosphere",
            "workup",
            "purification",
            "operation",
            "solvent",
            "other",
            "recovery",
            "conversion"
          ]
        },
        "target_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "role",
        "label",
        "name",
        "smiles",
        "smiles_parseable",
        "structure_verified",
        "amounts"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "reactant",
            "product",
            "reagent",
            "catalyst",
            "solvent",
            "unspecified_agent"
          ]
        },
        "label": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "smiles": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "smiles_parseable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "structure_verified": {
          "type": "boolean"
        },
        "amounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "participant_ids",
        "conditions"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "participant_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    }
  }
}